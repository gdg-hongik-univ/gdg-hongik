{
  "name": "gdg-hongik",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @gdg/landing dev",
    "dev:landing": "pnpm --filter @gdg/landing dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changesets.mjs",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "test:release": "node --test scripts/*.test.mjs",
    "release:check": "node scripts/release-pr.mjs",
    "tag-packages": "node scripts/tag-packages.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@changesets/parse": "0.4.3",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "semver": "7.8.5",
    "typescript": "~6.0.2",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{js,jsx,mjs,cjs,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
